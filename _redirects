# Domain-level canonical redirects are managed in Netlify site settings
# to avoid conflicts/loops with primary domain configuration.

# Do not serve internal planning docs or raw function source that live in the
# publish root. These paths are blocked at the edge (robots.txt only guides
# crawlers; this actually prevents direct access).
# The trailing "!" forces the rule even though matching files exist in the
# publish dir — without it Netlify serves the file and skips the redirect.
/docs/*     /404.html   404!
/netlify/*  /404.html   404!

# Tag filtering used to be a query param handled in the browser. It is now a
# set of static pages, so send the old URLs to the page that replaced them.
# Needs the forcing "!" for the same reason as the rules above: notes.html
# exists in the publish dir, so without it Netlify serves the file and skips
# the redirect.
/notes.html  tag=:tag  /notes/tag/:tag/  301!
